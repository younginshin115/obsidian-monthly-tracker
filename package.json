    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "rollup": "^3.0.0",
    "tslib": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
