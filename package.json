{
  "name": "monthly-tracker",
  "version": "1.0.0",
  "description": "Obsidian Monthly Tracker Plugin",
  "main": "main.js",
  "type": "module",
  "license": "MIT",
  "author": "Youngin Shin",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tracker",
    "heatmap",
    "habit-tracker"
  ],
  "scripts": {
